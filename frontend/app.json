{
  "expo": {
    "name": "piercer.ai",
    "slug": "piercer-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piercer.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "piercer.ai uses your camera to capture photos of the body part you want to preview jewelry on. Photos are processed in memory and never stored."
      }
    },
    "android": {
      "package": "com.piercer.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A050B"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A050B"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "2970ea0e-9543-40f9-bdab-711f9e120980"
      }
    },
    "owner": "arhanbayrams-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2970ea0e-9543-40f9-bdab-711f9e120980"
    }
  }
}
